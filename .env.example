# Copy to `.env` and fill in. `.env` is git-ignored — never commit real secrets.

# --- LiveKit ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Outbound SIP (Twilio trunk registered in LiveKit) ---
# The LiveKit SIP outbound trunk id (ST_...) created during setup.
SIP_OUTBOUND_TRUNK_ID=
# Caller ID shown to the candidate (E.164), i.e. your Twilio number.
OUTBOUND_CALLER_ID=+10000000000

# --- Providers ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# --- Twilio (used by setup only, not the runtime agent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- App settings ---
# Path to the candidate sheet (CSV) with columns: name, role, phone
CANDIDATE_SHEET=candidates.csv
# OpenAI model for the follow-up decision (reasoner.py). GPT-4o for now.
INTERVIEW_MODEL=gpt-4o
# STT / TTS model names for the realtime pipeline.
STT_MODEL=nova-3
TTS_MODEL=sonic-2
# Transcript backend: sqlite | jsonl
TRANSCRIPT_BACKEND=sqlite
TRANSCRIPT_PATH=transcripts.db
# Max follow-up questions per interview question.
MAX_FOLLOWUPS=2
# Agent worker name (must match dispatch config).
AGENT_NAME=soliant-interviewer
